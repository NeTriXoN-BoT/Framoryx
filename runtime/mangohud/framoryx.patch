--- a/src/control.cpp
+++ b/src/control.cpp
@@ -9,0 +10,3 @@
+#include "framoryx_stream.hpp"
+#include "framoryx_hud.hpp"
+#include <unistd.h>
@@ -18 +21,18 @@ static void parse_command(overlay_params &params,
-   if (!strncmp(cmd, "hud", cmdlen)) {
+   if (!strcmp(cmd, "framoryx_hud")) {
+      framoryx_hud::configure(std::string_view(param, paramlen ? paramlen - 1 : 0));
+   } else if (!strcmp(cmd, "framoryx_metrics")) {
+      framoryx_hud::metrics(std::string_view(param, paramlen ? paramlen - 1 : 0));
+   } else if (!strcmp(cmd, "framoryx_frames")) {
+      const auto packet = framoryx_stream::take();
+      if (!packet.empty()) {
+         const std::string response = ":FramoryxFrames=" + packet + ";";
+         if (os_socket_send(global_control_client, response.data(), response.size(), MSG_NOSIGNAL | MSG_DONTWAIT) != ssize_t(response.size())) {
+            framoryx_stream::reset(false);
+            shutdown(global_control_client, SHUT_RDWR);
+         }
+      }
+   } else if (!strcmp(cmd, "framoryx_stop")) {
+      framoryx_stream::reset(false);
+   } else if (!strcmp(cmd, "framoryx_reload")) {
+      parse_overlay_config(&params, getenv("MANGOHUD_CONFIG"), false);
+   } else if (!strncmp(cmd, "hud", cmdlen)) {
@@ -168,0 +189,7 @@ void control_client_check(int control, int& control_client, const std::string& d
+      // The application control channel is restricted to this user's session.
+      struct ucred peer = {};
+      socklen_t peer_size = sizeof(peer);
+      if (getsockopt(socket, SOL_SOCKET, SO_PEERCRED, &peer, &peer_size) || peer.uid != getuid()) {
+         os_socket_close(socket);
+         return;
+      }
@@ -176,0 +204 @@ static void control_client_disconnected(int& control_client)
+   framoryx_stream::reset(false);
@@ -183,0 +212 @@ void process_control_socket(int& control_client, overlay_params &params)
+      global_control_client = control_client;
