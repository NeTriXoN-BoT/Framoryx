#!/bin/sh
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
if [ "${1-}" = --version ]; then printf '%s\n' 'MangoHud v0.8.4 / Framoryx stream 1'; exit 0; fi
if [ "${1-}" = --dlsym ]; then shift; fi
[ "$#" -gt 0 ] || exit 2
export MANGOHUD=1
export MANGOHUD_DLSYM=1
export LD_PRELOAD="$root/lib/libMangoHud_shim.so${LD_PRELOAD:+:$LD_PRELOAD}"
export VK_LAYER_PATH="$root/layers${VK_LAYER_PATH:+:$VK_LAYER_PATH}"
case ":${VK_INSTANCE_LAYERS-}:" in
    *:VK_LAYER_MANGOHUD_overlay_x86_64:*) ;;
    *) export VK_INSTANCE_LAYERS="VK_LAYER_MANGOHUD_overlay_x86_64${VK_INSTANCE_LAYERS:+:$VK_INSTANCE_LAYERS}" ;;
esac
exec "$@"
